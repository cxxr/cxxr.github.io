{
  "id": "com.dinokeys.app",
  "name": "Dino Keys – Touch Typing for Kids",
  "short_name": "Dino Keys",
  "description": "A friendly dinosaur touch typing adventure for kids. Hatch eggs, explore prehistoric worlds, and learn touch-typing!",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "landscape",
  "background_color": "#7bd389",
